@model IEnumerable<Category>
@{
    ViewData["Title"] = "Danh mục";
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Danh mục sản phẩm</h1>
        <p class="text-muted mb-0">Quản lý nhóm hàng trong cửa hàng.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm danh mục</a>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th>Số sản phẩm</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có danh mục nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Id</td>
                            <td class="fw-semibold">@category.Name</td>
                            <td>@category.Description</td>
                            <td>@category.Products.Count</td>
                            <td>
                                <div class="action-group justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
