@model Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Chi tiết đơn hàng #@Model.Id</h1>
        <p class="text-muted mb-0">@Model.CustomerName - @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Xóa</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>

<div class="details-panel mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Mã đơn</dt>
        <dd class="col-sm-9">#@Model.Id</dd>
        <dt class="col-sm-3">Khách hàng</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>
        <dt class="col-sm-3">Số điện thoại</dt>
        <dd class="col-sm-9">@Model.CustomerPhone</dd>
        <dt class="col-sm-3">Ngày đặt</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Tổng tiền</dt>
        <dd class="col-sm-9 fw-bold">@Model.TotalAmount.ToString("N0") đ</dd>
    </dl>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td class="fw-semibold">@detail.Product?.Name</td>
                        <td>@detail.Product?.Category?.Name</td>
                        <td>@detail.Quantity</td>
                        <td>@detail.UnitPrice.ToString("N0") đ</td>
                        <td class="fw-bold">@detail.SubTotal.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
