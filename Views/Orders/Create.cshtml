@using System.Globalization
@model OrderCreateViewModel
@{
    ViewData["Title"] = "Tạo đơn hàng";
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Tạo đơn hàng</h1>
        <p class="text-muted mb-0">Chọn sản phẩm, nhập số lượng và lưu hóa đơn.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div>

<form asp-action="Create" method="post" class="form-panel">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="CustomerName" class="form-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerPhone" class="form-label"></label>
            <input asp-for="CustomerPhone" class="form-control" />
            <span asp-validation-for="CustomerPhone" class="text-danger"></span>
        </div>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Đơn giá</th>
                    <th>Tồn kho</th>
                    <th>Số lượng mua</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/product-placeholder.svg" : item.ImageUrl;
                    <tr class="order-row">
                        <td>
                            <input type="hidden" asp-for="Items[i].ProductId" />
                            <div class="d-flex align-items-center gap-2">
                                <img class="product-thumb" src="@imageUrl" alt="@item.ProductName" onerror="this.src='/images/product-placeholder.svg'" />
                                <span class="fw-semibold">@item.ProductName</span>
                            </div>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>@item.UnitPrice.ToString("N0") đ</td>
                        <td>@item.AvailableQuantity</td>
                        <td>
                            <input asp-for="Items[i].Quantity"
                                   class="form-control order-quantity"
                                   type="number"
                                   min="0"
                                   max="@item.AvailableQuantity"
                                   data-price="@item.UnitPrice.ToString(CultureInfo.InvariantCulture)" />
                            <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                        </td>
                        <td class="line-total fw-semibold">0 đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="total-box">
            Tổng tiền: <span id="orderTotal" class="ms-2">0 đ</span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu đơn hàng</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const currencyFormatter = new Intl.NumberFormat('vi-VN');

        function updateOrderTotals() {
            let total = 0;
            document.querySelectorAll('.order-row').forEach(row => {
                const input = row.querySelector('.order-quantity');
                const price = Number(input.dataset.price || 0);
                const quantity = Number(input.value || 0);
                const subTotal = price * quantity;
                total += subTotal;
                row.querySelector('.line-total').textContent = `${currencyFormatter.format(subTotal)} đ`;
            });

            document.getElementById('orderTotal').textContent = `${currencyFormatter.format(total)} đ`;
        }

        document.querySelectorAll('.order-quantity').forEach(input => {
            input.addEventListener('input', updateOrderTotals);
        });

        updateOrderTotals();
    </script>
}
