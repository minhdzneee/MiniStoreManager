@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng";
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Đơn hàng</h1>
        <p class="text-muted mb-0">Danh sách hóa đơn bán hàng đã lưu.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tạo đơn hàng</a>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Ngày đặt</th>
                    <th>Số dòng</th>
                    <th>Tổng tiền</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td class="fw-semibold">@order.CustomerName</td>
                            <td>@order.CustomerPhone</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.OrderDetails.Count</td>
                            <td class="fw-bold">@order.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <div class="action-group justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@order.Id">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
