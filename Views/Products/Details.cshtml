@model Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/product-placeholder.svg" : Model.ImageUrl;
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Chi tiết sản phẩm</h1>
        <p class="text-muted mb-0">@Model.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>

<div class="details-panel">
    <div class="row g-4">
        <div class="col-md-4">
            <img class="product-photo" src="@imageUrl" alt="@Model.Name" onerror="this.src='/images/product-placeholder.svg'" />
        </div>
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>
                <dt class="col-sm-4">Tên sản phẩm</dt>
                <dd class="col-sm-8">@Model.Name</dd>
                <dt class="col-sm-4">Danh mục</dt>
                <dd class="col-sm-8">@Model.Category?.Name</dd>
                <dt class="col-sm-4">Giá bán</dt>
                <dd class="col-sm-8 fw-bold">@Model.Price.ToString("N0") đ</dd>
                <dt class="col-sm-4">Số lượng tồn</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>
                <dt class="col-sm-4">Mô tả</dt>
                <dd class="col-sm-8">@Model.Description</dd>
                <dt class="col-sm-4">ImageUrl</dt>
                <dd class="col-sm-8 text-break">@Model.ImageUrl</dd>
            </dl>
        </div>
    </div>
</div>
