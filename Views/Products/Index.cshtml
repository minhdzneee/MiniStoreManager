@model ProductFilterViewModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="page-title-row">
    <div>
        <h1 class="h3 mb-1">Sản phẩm</h1>
        <p class="text-muted mb-0">Tra cứu, lọc và quản lý tồn kho.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

<form asp-action="Index" method="get" class="form-panel mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label asp-for="SearchTerm" class="form-label">Tìm theo tên</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Nhập tên sản phẩm" />
        </div>
        <div class="col-md-4">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Lọc</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Hình</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Tồn kho</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Không tìm thấy sản phẩm phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model.Products)
                    {
                        var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl) ? "/images/product-placeholder.svg" : product.ImageUrl;
                        <tr>
                            <td>
                                <img class="product-thumb" src="@imageUrl" alt="@product.Name" onerror="this.src='/images/product-placeholder.svg'" />
                            </td>
                            <td>
                                <div class="fw-semibold">@product.Name</div>
                                <div class="small text-muted">@product.Description</div>
                            </td>
                            <td>@product.Category?.Name</td>
                            <td>@product.Price.ToString("N0") đ</td>
                            <td>
                                <span class="badge badge-stock @(product.Quantity <= 10 ? "text-bg-danger" : "text-bg-success")">@product.Quantity</span>
                            </td>
                            <td>
                                <div class="action-group justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@product.Id">Chi tiết</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Sửa</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
